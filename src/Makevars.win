all: $(SHLIB)
$(SHLIB): cudd_pack/cudd/.libs/libcudd.a

# Header changes must rebuild all Rcudd objects with a consistent C++ layout.
RCUDD_HEADERS = rcudd.h bdd_prepare.h bdd_truth.h binary_lower_bound.h ../inst/include/rcudd/bdd_wcnf.hpp
$(OBJECTS): $(RCUDD_HEADERS)

# Changes in the bundled library must invalidate a previously built archive.
CUDD_SOURCES = cudd_pack/*/*.c cudd_pack/*/*.h cudd_pack/*/*.cc cudd_pack/*/*.hh
CUDD_BUILD_INPUTS = cudd_pack/configure cudd_pack/Makefile.in cudd_pack/config.h.in

cudd_pack/cudd/.libs/libcudd.a: $(CUDD_SOURCES) $(CUDD_BUILD_INPUTS)
	cd cudd_pack && \
	CC="$(CC)" CXX="$(CXX)" CPPFLAGS="$(CPPFLAGS) -DNDEBUG -I\"$(R_INCLUDE_DIR)\"" ./configure --enable-obj && \
	$(MAKE) CC="$(CC)" CXX="$(CXX)" CPPFLAGS="$(CPPFLAGS) -DNDEBUG -I\"$(R_INCLUDE_DIR)\""

clean: clean-cudd_pack clean-src

clean-cudd_pack:
	$(MAKE) -C cudd_pack clean
	$(MAKE) -C cudd_pack distclean

clean-src:
	rm -f *.o *.dll *.rds

PKG_CPPFLAGS = -DNDEBUG -Icudd_pack/cudd -Icudd_pack/cplusplus
PKG_LIBS = -Lcudd_pack/cudd/.libs -lcudd -lm -lpthread -lws2_32 -lpsapi

.PHONY: all cudd_pack clean clean-cudd_pack clean-src
